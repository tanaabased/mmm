# Python cache and venvs
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
.ruff_cache
.venv/
env/
venv/

# VSCode settings (optional to share)
.vscode/

# Jupyter Notebook metadata
.ipynb_checkpoints/

# LEAN CLI artifacts
.lean/
backtests/
live/
research/

# LEAN data (can be huge — don’t commit)
data/*
_cached_data/
*_data/
!data/.gitkeep

# Local logs or reports
logs/
*.log
*.html
*.csv
*.json

# Docker garbage (if used)
*.pid
*.pid.lock

# Secrets or keys
secrets.env
*.api_key
*.token

# Mac OS junk
.DS_Store

# Python test coverage
.coverage
htmlcov/
*.egg-info/
