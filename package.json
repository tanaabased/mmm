{
  "name": "@tanaab/mmm",
  "version": "0.0.0",
  "description": "MMM application scaffold",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanaabased/mmm.git"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=26 <27"
  },
  "bin": {
    "mmm": "./dist/mmm.js",
    "mmm-server": "./dist/mmm-server.js",
    "mmm-tui": "./dist/mmm-tui.js"
  },
  "files": [
    "dist/",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build-task.ts",
    "lint:eslint": "bun run --bun eslint .",
    "format:check": "bun run --bun prettier . --check --ignore-unknown",
    "format:write": "bun run --bun prettier . --write --ignore-unknown",
    "lint": "bun run lint:eslint && bun run format:check",
    "typecheck": "bun run --bun tsc --noEmit",
    "test:unit": "bun ./node_modules/mocha/bin/mocha.js 'test/**/*.spec.ts'",
    "test": "bun run test:unit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "mocha": "^12.0.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.0"
  }
}
