{
  "name": "@tanaab/mmm",
  "version": "0.0.0",
  "description": "MMM application scaffold",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanaabased/mmm.git"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=26 <27"
  },
  "bin": {
    "mmm": "./dist/mmm.js"
  },
  "files": [
    "dist/",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build-task.ts",
    "lint:eslint": "bun run --bun eslint .",
    "format:check": "bun run --bun prettier . --check --ignore-unknown",
    "format:write": "bun run --bun prettier . --write --ignore-unknown",
    "lint": "bun run lint:eslint && bun run format:check",
    "typecheck": "bun run --bun tsc --noEmit",
    "test:unit": "bun --bun ./node_modules/mocha/bin/mocha.js 'test/*.spec.ts'",
    "test:research": "bun scripts/check-research-task.ts",
    "test:package": "bun scripts/check-package-task.ts",
    "test": "bun run test:unit && bun run test:research"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/luxon": "3.7.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "luxon": "3.7.2",
    "mocha": "11.7.0",
    "prettier": "^3.9.9",
    "simple-statistics": "7.12.1",
    "trading-signals": "8.3.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
